{
  "name": "science-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "gold:export:local": "tsx --env-file=.env.local-worker apps/worker/src/export-gold.ts",
    "sources:ingest:local": "tsx --env-file=.env.local-worker apps/worker/src/ingest.ts",
    "sources:ingest": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/worker/src/ingest.ts",
    "web:local:env": "node scripts/local-web-env.mjs",
    "web:local:editor": "node scripts/local-editor.mjs",
    "web:local": "node scripts/local-web.mjs dev",
    "web:local:start": "node scripts/local-web.mjs start",
    "test:editorial:web": "tsx tests/integration/editorial-web.ts",
    "dev": "npm run dev --workspace=@science/web",
    "build": "npm run build --workspace=@science/web",
    "start": "npm run start --workspace=@science/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@science/web",
    "test": "vitest run",
    "demo": "tsx --env-file-if-exists=.env apps/worker/src/demo.ts",
    "worker:once": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/worker/src/once.ts",
    "worker:local": "tsx --env-file=.env.local-worker apps/worker/src/once.ts",
    "worker:enqueue": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local apps/worker/src/enqueue.ts",
    "worker:local:enqueue": "tsx --env-file=.env.local-worker apps/worker/src/enqueue.ts",
    "video:render": "tsx --env-file-if-exists=.env apps/worker/src/render.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:test": "supabase test db",
    "db:test:integration": "tsx tests/integration/database.ts",
    "db:local:env": "node scripts/local-env.mjs",
    "db:remote:plan": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/remote-database.mjs plan",
    "db:remote:apply": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/remote-database.mjs apply",
    "budget:local:init": "tsx --env-file=.env.local-worker apps/worker/src/production-budget.ts init",
    "budget:local:review": "tsx --env-file=.env.local-worker apps/worker/src/production-budget.ts review",
    "budget:local:rehearse": "tsx --env-file=.env.local-worker apps/worker/src/production-budget.ts rehearse",
    "production:local:plan": "tsx --env-file=.env.local-worker apps/worker/src/production-budget.ts plan",
    "test:budget:integration": "tsx tests/integration/budget.ts",
    "budget:local:recover": "tsx --env-file=.env.local-worker apps/worker/src/production-budget.ts recover",
    "test:reviews:integration": "tsx tests/integration/review-import.ts",
    "web:local:review-key": "node scripts/local-review-signing-env.mjs",
    "test:metadata:integration": "tsx tests/integration/metadata.ts",
    "test:metadata:network": "tsx --env-file=.env.local-worker tests/integration/metadata-network.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.1",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
