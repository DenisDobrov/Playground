# Copy to .env for worker CLI. Web currently uses demo data only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=academy
SUPABASE_STORAGE_BUCKET=dobrov-academy-assets
# Existing cloud project, not a new subscription. URL is not a secret.
SUPABASE_PROJECT_REF=upwrplsgunjanragbggb
# PostgreSQL session-pooler/direct connection string from Dashboard > Connect.
# Keep password here locally; never pass it as a command argument or paste it into chat.
SUPABASE_DB_URL=
# Optional verified CA certificate file if required by your connection.
SUPABASE_DB_CA_FILE=
# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Select available models explicitly; no hard-coded paid model fallback.
GEMINI_MODEL=
VERIFIER_PROVIDER=
VERIFIER_MODEL=
MONTHLY_BUDGET_USD=200
STORY_BUDGET_USD=3
VIDEO_BUDGET_USD=12
PUBLICATION_ENABLED=false
# Future OAuth integration; never put refresh tokens into the repository.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
FFMPEG_PATH=ffmpeg
