# Copy to .env for worker CLI. Web currently uses demo data only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Select available models explicitly; no hard-coded paid model fallback.
GEMINI_MODEL=
VERIFIER_PROVIDER=
VERIFIER_MODEL=
MONTHLY_BUDGET_USD=200
STORY_BUDGET_USD=3
VIDEO_BUDGET_USD=12
PUBLICATION_ENABLED=false
# Future OAuth integration; never put refresh tokens into the repository.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
FFMPEG_PATH=ffmpeg
